{
  "name": "__PROJECT_NAME__",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "worker": "pnpm --filter worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @saas/db prisma migrate dev",
    "db:seed": "pnpm --filter @saas/db db:seed",
    "format": "prettier -w .",
    "docker:build:web": "docker build -f apps/web/Dockerfile .",
    "docker:build:worker": "docker build -f apps/worker/Dockerfile ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
