generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  clerkUserId   String          @unique
  email         String
  name          String?
  createdAt     DateTime        @default(now())
  orgMembers    OrgMember[]
  subscriptions Subscription[]
  purchases     Purchase[]
}

model Org {
  id            String          @id @default(uuid())
  clerkOrgId    String          @unique
  name          String
  slug          String          @unique
  createdAt     DateTime        @default(now())
  members       OrgMember[]
  subscriptions Subscription[]
  purchases     Purchase[]
}

model OrgMember {
  id                   String @id @default(uuid())
  orgId                String
  userId               String
  clerkOrgMembershipId String @unique
  role                 String
  org                  Org    @relation(fields: [orgId], references: [id])
  user                 User   @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

model Subscription {
  id                   String   @id @default(uuid())
  scope                String
  orgId                String?
  userId               String?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  status               String
  plan                 String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  metadataJson         Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  org                  Org?     @relation(fields: [orgId], references: [id])
  user                 User?    @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
}

model Purchase {
  id                    String   @id @default(uuid())
  scope                 String
  orgId                 String?
  userId                String?
  stripeCustomerId      String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String?  @unique
  stripeInvoiceId       String?  @unique
  productCode           String
  status                String
  amountSubtotal        Int?
  amountTotal           Int?
  currency              String?
  metadataJson          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  org                   Org?     @relation(fields: [orgId], references: [id])
  user                  User?    @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
}

model StripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  payloadJson   Json
  processedAt   DateTime?
  createdAt     DateTime @default(now())
}

model ClerkEvent {
  id           String   @id @default(uuid())
  clerkEventId String   @unique
  type         String
  createdAt    DateTime @default(now())
}

model EmailEvent {
  id          String   @id @default(uuid())
  eventName   String
  scope       String
  orgId       String?
  userId      String?
  payloadJson Json
  status      String
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
